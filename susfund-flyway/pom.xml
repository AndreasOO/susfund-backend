    <artifactId>susfund-flyway</artifactId>
    <name>susfund-flyway</name>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>org.andjos</groupId>
            <artifactId>susfund-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.andjos</groupId>
            <artifactId>susfund-repository</artifactId>
